---
import {getForecast} from '../lib/weather';
import {parseForecast,modelSignal} from '../lib/weather-model';
const data=await getForecast();const report=data?parseForecast(data.payload):null;
const C={title:'മുന്നാർ പ്രദേശത്തെ കാലാവസ്ഥ / Regional weather',error:'പുതിയ സാധുവായ പ്രവചനം ലഭ്യമല്ല. പഴയതോ പകരം കണക്കുകളോ കാണിക്കുന്നില്ല. / Fresh valid forecast unavailable; no old or substitute numbers.',temp:'താപനില / Temperature',wind:'കാറ്റ് / Wind',rain:'ദിവസത്തെ പരമാവധി മഴസാധ്യത / Daily maximum rain probability',uv:'ദിവസത്തെ പരമാവധി UV / Daily maximum UV',model:'മോഡൽ സമയം / Model time',retrieved:'ലഭിച്ചത് / Provider retrieved',checked:'പരിശോധിച്ചത് / Page check',thunder:'ഇടിമിന്നൽ മോഡൽ സൂചന; ഔദ്യോഗിക മുന്നറിയിപ്പും പ്രാദേശിക സാഹചര്യവും പരിശോധിക്കുക. / Thunder model signal; check official warnings and local conditions.',heavyRain:'കനത്ത മഴയുടെ മോഡൽ സൂചന; മുന്നറിയിപ്പും വഴിയുടെ നിലയും പരിശോധിക്കുക. / Heavy-rain model signal; check warnings and paths.',fog:'മൂടൽമഞ്ഞിന്റെ മോഡൽ സൂചന; കാഴ്ചയും റോഡും പരിശോധിക്കുക. / Fog model signal; check visibility and roads.'};
const labels:Record<number,string>={0:'Clear / തെളിഞ്ഞത്',1:'Mainly clear / മിക്കവാറും തെളിഞ്ഞത്',2:'Partly cloudy / ഭാഗിക മേഘം',3:'Overcast / മേഘാവൃതം',45:'Fog / മൂടൽമഞ്ഞ്',48:'Rime fog / തണുത്ത മൂടൽമഞ്ഞ്',51:'Light drizzle / നേരിയ ചാറ്റൽ',53:'Drizzle / ചാറ്റൽ',55:'Dense drizzle / കനത്ത ചാറ്റൽ',56:'Light freezing drizzle / മരവിക്കുന്ന നേരിയ ചാറ്റൽ',57:'Dense freezing drizzle / മരവിക്കുന്ന കനത്ത ചാറ്റൽ',61:'Light rain / നേരിയ മഴ',63:'Moderate rain / മിതമായ മഴ',65:'Heavy rain / കനത്ത മഴ',66:'Light freezing rain / മരവിക്കുന്ന നേരിയ മഴ',67:'Heavy freezing rain / മരവിക്കുന്ന കനത്ത മഴ',71:'Light snow / നേരിയ മഞ്ഞുവീഴ്ച',73:'Moderate snow / മിതമായ മഞ്ഞുവീഴ്ച',75:'Heavy snow / കനത്ത മഞ്ഞുവീഴ്ച',77:'Snow grains / മഞ്ഞുതരികൾ',80:'Light showers / നേരിയ മഴച്ചാറൽ',81:'Moderate showers / മിതമായ മഴച്ചാറൽ',82:'Violent showers / അതിശക്ത മഴച്ചാറൽ',85:'Snow showers / മഞ്ഞുചാറൽ',86:'Heavy snow showers / കനത്ത മഞ്ഞുചാറൽ',95:'Thunderstorm / ഇടിമിന്നൽ',96:'Thunderstorm with hail / ആലിപ്പഴത്തോടെയുള്ള ഇടിമിന്നൽ',99:'Thunderstorm with heavy hail / കനത്ത ആലിപ്പഴത്തോടെയുള്ള ഇടിമിന്നൽ'};
const format=(at:number)=>new Date(at).toLocaleString('en-GB',{timeZone:'Asia/Kolkata'});
---
<section id="weather" class="section"><div class="shell"><h2>{C.title}</h2><p>തോട്ടത്തിനടുത്തുള്ള സ്ഥിരമായ പ്രാദേശിക ബിന്ദുവിന്റെ Open-Meteo മോഡൽ പ്രവചനമാണ്; തോട്ടത്തിലെ നേരിട്ടുള്ള അളവോ പ്രവേശനാനുമതിയോ അല്ല. / <span lang="en">A regional model near the garden, not on-site measurement, an opening notice or safety clearance.</span></p><div id="weather-root" aria-live="polite">{report&&data?<><div class="card"><h3>{C.temp}: {Math.round(report.current.temperature)}°C</h3><p>{labels[report.current.code]}</p><p>{C.wind}: {Math.round(report.current.wind)} km/h</p><p>{C.rain}: {report.days[0].probability}%</p>{report.days[0].uv!==null&&<p>{C.uv}: {report.days[0].uv}</p>}{modelSignal(report.current.code)&&<p class="weather-warning">{C[modelSignal(report.current.code)!]}</p>}<p class="small">{C.model}: {report.modelTime} · Asia/Kolkata</p><p class="small">{C.retrieved}: {format(data.retrievedAt)}</p><p class="small">{C.checked}: {format(Date.now())}</p></div><div class="weather-grid">{report.days.map(d=><div class="card"><h3>{d.date}</h3><p>{labels[d.code]}</p><p>{Math.round(d.min)}° / {Math.round(d.max)}°C</p><p>{C.rain}: {d.probability}%</p>{modelSignal(d.code)&&<p class="weather-warning">{C[modelSignal(d.code)!]}</p>}</div>)}</div></>:<p class="card">{C.error}</p>}</div><script id="weather-copy" type="application/json" is:inline set:html={JSON.stringify({C,labels})}/><p class="small">പേജ് സജീവമായിരിക്കുമ്പോൾ 15 മിനിറ്റിൽ വീണ്ടും പരിശോധിക്കുന്നു; പിഴവ് വന്നാൽ കണക്കുകൾ നീക്കും. മഴസാധ്യതയും തീവ്രതയും വ്യത്യസ്തമാണ്. / <span lang="en">Refreshes every 15 minutes while active; failures clear numbers. Rain probability is separate from intensity, and climate averages are not labelled current weather.</span></p><p><a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · <a href="https://mausam.imd.gov.in/">IMD official warnings / ഔദ്യോഗിക മുന്നറിയിപ്പ്</a></p></div></section>
<script>
import {parseForecast,modelSignal} from '../lib/weather-model';
const root=document.getElementById('weather-root'),copy=document.getElementById('weather-copy');
if(root&&copy){const{C,labels}=JSON.parse(copy.textContent||'{}');let last=Date.now(),loading=false;
const el=(tag:string,text:string,cls='')=>{const e=document.createElement(tag);e.textContent=text;e.className=cls;return e;};const format=(n:number)=>new Date(n).toLocaleString('en-GB',{timeZone:'Asia/Kolkata'});const clear=()=>{root.replaceChildren(el('p',C.error,'card'));last=0;};
const load=async()=>{if(loading)return;loading=true;try{const response=await fetch('/api/weather.json',{cache:'no-store',signal:AbortSignal.timeout(12000)});if(!response.ok)throw Error('status');const data=await response.json();const report=parseForecast(data.payload);if(!report||typeof data.retrievedAt!=='number'||!Number.isFinite(data.retrievedAt)||Date.now()-data.retrievedAt>30*60000||data.retrievedAt>Date.now()+60000)throw Error('invalid');const n=report.current,d=report.days[0],card=el('div','','card');card.append(el('h3',`${C.temp}: ${Math.round(n.temperature)}°C`),el('p',labels[n.code]),el('p',`${C.wind}: ${Math.round(n.wind)} km/h`),el('p',`${C.rain}: ${d.probability}%`));if(d.uv!==null)card.append(el('p',`${C.uv}: ${d.uv}`));const signal=modelSignal(n.code);if(signal)card.append(el('p',C[signal],'weather-warning'));card.append(el('p',`${C.model}: ${report.modelTime} · Asia/Kolkata`,'small'),el('p',`${C.retrieved}: ${format(data.retrievedAt)}`,'small'),el('p',`${C.checked}: ${format(Date.now())}`,'small'));const grid=el('div','','weather-grid');for(const d of report.days){const item=el('div','','card');item.append(el('h3',d.date),el('p',labels[d.code]),el('p',`${Math.round(d.min)}° / ${Math.round(d.max)}°C`),el('p',`${C.rain}: ${d.probability}%`));const signal=modelSignal(d.code);if(signal)item.append(el('p',C[signal],'weather-warning'));grid.append(item);}root.replaceChildren(card,grid);last=Date.now();}catch{clear();}finally{loading=false;}};
load();setInterval(()=>{if(document.visibilityState==='visible')load();else if(last&&Date.now()-last>30*60000)clear();},15*60000);document.addEventListener('visibilitychange',()=>{if(document.visibilityState!=='visible')return;if(last&&Date.now()-last>30*60000)clear();if(!last||Date.now()-last>15*60000)load();});}
</script>
