---
import '../styles/global.css';
interface Props{title:string;description:string;noindex?:boolean;lang?:string;canonicalPath?:string;}
const{title,description,noindex=false,lang='ml-IN',canonicalPath}=Astro.props;
const canonical=new URL(canonicalPath??Astro.url.pathname,'https://munnarrose.com').href;
const ogLocale=lang==='en'?'en_IN':'ml_IN';
const isMl=lang==='ml-IN';
const brandSub=isMl?'സ്വതന്ത്ര ഗൈഡ് / Independent guide':'Independent guide';
const skipText=isMl?'പ്രധാന ഉള്ളടക്കം / Skip to content':'Skip to content';
const menuSummary=isMl?'വിഷയങ്ങൾ / Menu ▾':'Menu ▾';
const navAria=isMl?'വിഷയങ്ങൾ / Topics':'Topics';
const navItems=[
 {href:'/#identity',label:isMl?'Identity / തിരിച്ചറിയൽ':'Identity'},
 {href:'/guides/',label:isMl?'Visitor guides / ഗൈഡുകൾ':'Visitor guides'},
 {href:'/#visit',label:isMl?'Hours & fees / സമയം':'Hours & fees'},
 {href:'/#location',label:isMl?'Location / സ്ഥലം':'Location'},
 {href:'/#contact',label:'KFDC contact'},
 {href:'/#weather',label:isMl?'Weather / കാലാവസ്ഥ':'Weather'},
 {href:'/#faq',label:'FAQ'},
 {href:'/#sources',label:isMl?'Sources / ഉറവിടങ്ങൾ':'Sources'},
 {href:'/#privacy',label:isMl?'Privacy / സ്വകാര്യത':'Privacy'},
];
const footerNoteMl='ലാഭേച്ഛയില്ലാത്ത സ്വതന്ത്ര വിനോദസഞ്ചാര-വിദ്യാഭ്യാസ വിവരഗൈഡ്; KFDC, കേരള ടൂറിസം അല്ലെങ്കിൽ താമസസ്ഥലത്തിന്റെ ഔദ്യോഗിക സൈറ്റ് അല്ല.';
const footerNoteEn='An independent, unofficial nonprofit tourism and educational information guide, separate from KFDC, Kerala Tourism and accommodation operators.';
const footerLinks=[
 {href:'/guides/',label:isMl?'Guides / ഗൈഡുകൾ':'Guides'},
 {href:'/#privacy',label:isMl?'സ്വകാര്യത / Privacy':'Privacy'},
 {href:'/#terms',label:isMl?'ഉപയോഗ നിബന്ധനകൾ / Terms':'Terms'},
 {href:'/#image-credits',label:isMl?'ചിത്രങ്ങൾ / Photos':'Photos'},
];
const image='https://munnarrose.com/images/flowerbed-social.jpg';
const alt=isMl?'IM3847 ന്റെ 2017 ലെ പൂക്കിടക്ക ചിത്രം; ചരിത്രഫോട്ടോ, ഇന്നത്തെ സ്ഥിതിയല്ല / Historical Munnar Rose Gardens flower beds; cropped 2017 photograph by IM3847':'Historical Munnar Rose Gardens flower beds; cropped 2017 photograph by IM3847';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={ogLocale}/>{lang==='ml-IN'&&<meta property="og:locale:alternate" content="en_US"/>}<meta property="og:site_name" content="Munnar Rose Garden — independent guide"/><meta property="og:image" content={image}/><meta property="og:image:alt" content={alt}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><meta name="twitter:image:alt" content={alt}/><meta name="theme-color" content="#1f654e"/><link rel="manifest" href="/manifest.webmanifest"/><link rel="icon" href="/icons/favicon.svg"/><slot name="head"/><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script></head><body><a href="#main" class="skip">{skipText}</a><header><div class="shell header-shell"><a class="brand" href="/"><img src="/icons/logo.svg" width="48" height="48" alt=""/><span>Munnar Rose Garden<small>{brandSub}</small></span></a><details class="menu"><summary>{menuSummary}</summary><nav aria-label={navAria}>{navItems.map(n=><a href={n.href}>{n.label}</a>)}</nav></details></div></header><main id="main"><slot/></main><footer class="section"><div class="shell">{isMl&&<p>{footerNoteMl}</p>}<p lang="en">{footerNoteEn}</p><p><a href="/guides/">{footerLinks[0].label}</a> · <a href="/#privacy">{footerLinks[1].label}</a> · <a href="/#terms">{footerLinks[2].label}</a> · <a href="/#image-credits">{footerLinks[3].label}</a></p></div></footer><script is:inline>if('serviceWorker'in navigator){navigator.serviceWorker.getRegistrations().then(rs=>{for(const r of rs){if(new URL(r.active?.scriptURL||r.installing?.scriptURL||location.origin).pathname==='/sw.js')r.update();}}).catch(()=>{});}</script></body></html>
