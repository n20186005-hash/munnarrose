---
import BaseLayout from '../layouts/BaseLayout.astro';

const imageSources = {
  hero: 'https://upload.wikimedia.org/wikipedia/commons/6/67/Flora_at_Munnar_Rose_Gardens_11.jpg',
  pond: 'https://upload.wikimedia.org/wikipedia/commons/0/06/Flora_at_Munnar_Rose_Gardens_12.jpg',
  foliage: 'https://upload.wikimedia.org/wikipedia/commons/1/1f/Flora_at_Munnar_Rose_Gardens_13.jpg',
  flower: 'https://upload.wikimedia.org/wikipedia/commons/5/54/A_flower_in_the_Rose_garden_in_Munnar_01.jpg'
};

const siteUrl = Astro.site?.toString();
const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Munnar Rose Garden',
  alternateName: 'KFDC Floriculture Centre',
  description: 'മുന്നാറിലെ റോസ് നഗറിൽ, മാട്ടുപ്പെട്ടി റോഡിനരികിലെ പുഷ്പോദ്യാനം.',
  url: siteUrl,
  image: siteUrl ? [new URL('/images/rose-garden-hero.jpg', siteUrl).toString()] : undefined,
  telephone: '+91 94968 22059',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Munnar - Aluva Rd, Rose Nagar, Mattupetty',
    addressLocality: 'Munnar',
    addressRegion: 'Kerala',
    postalCode: '685612',
    addressCountry: 'IN'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 10.08583, longitude: 77.07583 },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '08:00', closes: '18:00'
  }],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.3', bestRating: '5' },
  priceRange: '₹'
};

const faq = [
  ['റോസ് ഗാർഡൻ സാധാരണ എപ്പോൾ തുറന്നിരിക്കും?', 'Google Maps-ൽ ഇപ്പോൾ ദിവസവും രാവിലെ 8 മുതൽ വൈകിട്ട് 6 വരെ എന്നാണ് കാണിക്കുന്നത്. സീസണൽ മാറ്റങ്ങൾ ഉണ്ടാകാം; യാത്രയ്ക്കു മുമ്പ് സമയക്രമം വീണ്ടും പരിശോധിക്കുക.'],
  ['പ്രവേശന ഫീസ് എത്രയാണ്?', 'സമീപകാല യാത്രക്കാരുടെ റിപ്പോർട്ടുകളിൽ ഒരാൾക്ക് ഏകദേശം ₹50 എന്ന് കാണുന്നു. നിരക്കുകൾ മാറാവുന്നതിനാൽ ടിക്കറ്റ് കൗണ്ടറിലെ നിലവിലെ നിരക്ക് സ്ഥിരീകരിക്കുക.'],
  ['എത്ര സമയം മാറ്റിവെക്കണം?', 'ഫോട്ടോഗ്രഫിയോടുകൂടിയ ശാന്തമായ സന്ദർശനത്തിന് 45–75 മിനിറ്റ് സാധാരണയായി മതിയാകും. പൂക്കളെയും നഴ്സറി വിഭാഗങ്ങളെയും വിശദമായി കാണണമെങ്കിൽ കൂടുതൽ സമയം അനുവദിക്കാം.'],
  ['കുട്ടികളോടൊപ്പം വരാൻ പറ്റുമോ?', 'അതെ. എന്നാൽ തോട്ടം കുന്നിൻ ചെരിവിലായി ടെറസുകളായി ക്രമീകരിച്ചിരിക്കുന്നതിനാൽ ചില ഭാഗങ്ങളിൽ പടികളും ചരിവുകളും ഉണ്ടാകാം.'],
  ['പാർക്കിംഗ് ലഭ്യമാണോ?', 'റോഡ്‌സൈഡ്/പ്രാദേശിക പാർക്കിംഗ് സാധാരണ ലഭ്യമാണെന്ന് പ്രാദേശിക ഗൈഡ് സ്രോതസ്സുകൾ പറയുന്നു. തിരക്കേറിയ സമയങ്ങളിൽ സ്ഥലം പരിമിതമായേക്കാം.'],
  ['മഴക്കാലത്ത് സന്ദർശിക്കാമോ?', 'സന്ദർശിക്കാം, പക്ഷേ പാതകൾ നനഞ്ഞിരിക്കാം. ഗ്രിപ്പ് ഉള്ള ചെരുപ്പും ലളിതമായ മഴക്കോടും ഉപകാരപ്പെടും.']
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};
---
<BaseLayout title="മുന്നാർ റോസ് ഗാർഡൻ | പൂക്കളും മലമഞ്ഞും ചേർന്നൊരു ചെറുസഞ്ചാരം" description="മുന്നാർ റോസ് ഗാർഡൻ സന്ദർശന ഗൈഡ് — സമയം, ഫീസ്, യാത്രാമാർഗം, പാർക്കിംഗ്, ഭക്ഷണം, സമീപ ആകർഷണങ്ങൾ, Google മാപ്പ്, FAQ.">
  <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <header class="hero-photo" style={`background-image:url('${imageSources.hero}')`}>
    <nav class="wrap relative z-10 flex items-center justify-between py-5 text-white">
      <a href="#top" class="flex items-center gap-3 no-underline" aria-label="മുന്നാർ റോസ് ഗാർഡൻ ഹോം">
        <img src="/icons/logo.svg" alt="" width="48" height="48" />
        <div><strong class="block text-sm tracking-wide">MUNNAR</strong><span class="text-xs opacity-80">ROSE GARDEN</span></div>
      </a>
      <a href="#map" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm no-underline backdrop-blur">മാപ്പ് കാണുക ↗</a>
    </nav>
    <div id="top" class="wrap relative z-10 flex min-h-[62vh] items-end pb-10 text-white">
      <div class="max-w-4xl">
        <p class="eyebrow !text-pink-200">മുന്നാർ · കേരളം · 685612</p>
        <h1 class="title mt-3">മലമഞ്ഞിനിടയിലെ<br/>ഒരു നിറഞ്ഞ പൂക്കാലം.</h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-white/85">റോസ് നഗറിൽ, മാട്ടുപ്പെട്ടിയിലേക്കുള്ള വഴിയരികിൽ പച്ചമലകളുടെയും ചായത്തോട്ടങ്ങളുടെയും പശ്ചാത്തലത്തിൽ ടെറസുകളായി വിരിയുന്ന മുന്നാർ റോസ് ഗാർഡൻ.</p>
        <div class="facts mt-8">
          <div class="fact"><span class="text-xs opacity-70">Google റേറ്റിംഗ്</span><strong class="mt-1 block text-lg">4.3 / 5</strong></div>
          <div class="fact"><span class="text-xs opacity-70">സമയം</span><strong class="mt-1 block text-lg">08:00–18:00</strong></div>
          <div class="fact"><span class="text-xs opacity-70">ശുപാർശ സമയം</span><strong class="mt-1 block text-lg">45–75 മിനിറ്റ്</strong></div>
          <div class="fact"><span class="text-xs opacity-70">സ്ഥാനം</span><strong class="mt-1 block text-lg">Rose Nagar</strong></div>
        </div>
      </div>
    </div>
    <div class="petals"><i class="petal" style="left:11%;top:19%;--r:18deg"></i><i class="petal" style="left:74%;top:22%;--r:73deg"></i><i class="petal" style="left:88%;top:55%;--r:18deg"></i><i class="petal" style="left:62%;top:72%;--r:120deg"></i></div>
  </header>

  <main>
    <section class="section">
      <div class="wrap grid gap-10 lg:grid-cols-[.9fr_1.4fr] lg:items-center">
        <div class="flowers">
          <p class="eyebrow">പുഷ്പോദ്യാനം</p>
          <h2 class="section-title mt-2">റോസുകൾ മാത്രം അല്ല.</h2>
          <p class="mt-5 leading-8 muted">റോസുകൾക്കൊപ്പം വിവിധ അലങ്കാരച്ചെടികൾ, ജലസസ്യങ്ങൾ, പച്ചച്ചെടികൾ, ഔഷധ/മസാല സസ്യങ്ങൾ എന്നിവയും കാണാം. കുന്നിൻ ചെരിവിനനുസരിച്ചുള്ള പടിനില ക്രമീകരണം തോട്ടത്തിന് മുന്നാറിന്റെ സ്വാഭാവിക ഭൂപ്രകൃതിയോട് ചേർന്നൊരു വ്യക്തിത്വം നൽകുന്നു.</p>
          <div class="mt-6 flex flex-wrap gap-2"><span class="chip">🌹 നിറവൈവിധ്യം</span><span class="chip">📷 ഫോട്ടോഗ്രഫി</span><span class="chip">🌿 സസ്യപരിചയം</span><span class="chip">⛰️ മലക്കാഴ്ച</span></div>
        </div>
        <div class="photo-grid" aria-label="മുന്നാർ റോസ് ഗാർഡന്റെ യഥാർത്ഥ ചിത്രങ്ങൾ">
          <img src={imageSources.hero} alt="മുന്നാർ റോസ് ഗാർഡനിലെ വർണാഭമായ ഇംപേഷ്യൻസ് പൂക്കൾ" loading="lazy" />
          <img src={imageSources.pond} alt="റോസ് ഗാർഡനിലെ ജലസസ്യക്കുളം" loading="lazy" />
          <img src={imageSources.foliage} alt="ചുവന്ന ഇലച്ചെടികളാൽ വളഞ്ഞ അലങ്കാരക്കുളം" loading="lazy" />
          <img src={imageSources.flower} alt="മുന്നാർ റോസ് ഗാർഡനിലെ പിങ്ക് പൂവ്" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section bg-[#eef5ec]">
      <div class="wrap">
        <p class="eyebrow">പ്ലാൻ ചെയ്യാം</p><h2 class="section-title mt-2">സന്ദർശനത്തിന് വേണ്ട പ്രധാന വിവരങ്ങൾ</h2>
        <div class="info-grid mt-8">
          <article class="card info-card"><div class="icon">🎟️</div><h3 class="mt-4 font-bold">ടിക്കറ്റ് / ഫീസ്</h3><p class="mt-2 text-sm leading-7 muted">യാത്രക്കാരുടെ സമീപകാല റിപ്പോർട്ടുകളിൽ ഏകദേശം ₹50/വ്യക്തി. നിരക്കുകൾ മാറാം; കൗണ്ടറിൽ സ്ഥിരീകരിക്കുക.</p></article>
          <article class="card info-card"><div class="icon">🕗</div><h3 class="mt-4 font-bold">മികച്ച സമയം</h3><p class="mt-2 text-sm leading-7 muted">രാവിലെ 8–10 അല്ലെങ്കിൽ വൈകുന്നേരത്തെ മൃദുവായ വെളിച്ചം. മഴയ്ക്ക് ശേഷമുള്ള പച്ചപ്പും മനോഹരം, പക്ഷേ പാതകൾ വഴുക്കാം.</p></article>
          <article class="card info-card"><div class="icon">⏱️</div><h3 class="mt-4 font-bold">താമസ സമയം</h3><p class="mt-2 text-sm leading-7 muted">സാധാരണ 45–75 മിനിറ്റ്. സസ്യങ്ങൾ നിരീക്ഷിക്കാനും ഫോട്ടോ എടുക്കാനും ഇഷ്ടമുള്ളവർ കൂടുതൽ സമയം കണക്കാക്കാം.</p></article>
          <article class="card info-card"><div class="icon">🅿️</div><h3 class="mt-4 font-bold">പാർക്കിംഗ്</h3><p class="mt-2 text-sm leading-7 muted">പ്രാദേശിക ഗൈഡ് സ്രോതസ്സുകൾ പാർക്കിംഗ് ലഭ്യമാണെന്ന് സൂചിപ്പിക്കുന്നു. വാരാന്ത്യ/പീക്ക് സമയങ്ങളിൽ നേരത്തെ എത്തുക.</p></article>
          <article class="card info-card"><div class="icon">👟</div><h3 class="mt-4 font-bold">നടത്തം</h3><p class="mt-2 text-sm leading-7 muted">ടെറസ് രൂപത്തിലുള്ള തോട്ടം; പടികളും ചെരിവും ഉണ്ട്. മുതിർന്നവർക്കും കാൽമുട്ട് പ്രശ്നമുള്ളവർക്കും സാവധാനമായി നീങ്ങുക.</p></article>
          <article class="card info-card"><div class="icon">☕</div><h3 class="mt-4 font-bold">സൗകര്യങ്ങൾ</h3><p class="mt-2 text-sm leading-7 muted">ശൗചാലയം, ലഘുഭക്ഷണം/കോഫി, ചെറിയ വിൽപ്പന/നഴ്സറി സൗകര്യങ്ങൾ ഉണ്ടെന്ന് യാത്രാ സ്രോതസ്സുകൾ പറയുന്നു.</p></article>
        </div>
        <p class="notice mt-7 text-sm leading-7"><strong>ശ്രദ്ധിക്കുക:</strong> സമയം, ഫീസ്, ക്യാമറ ചാർജ് തുടങ്ങിയവയ്ക്കായി വിവിധ സ്രോതസ്സുകളിൽ ചെറിയ വ്യത്യാസങ്ങൾ കാണുന്നു. പുറപ്പെടും മുമ്പ് Google Maps അല്ലെങ്കിൽ സ്ഥലത്തെ കൗണ്ടർ വഴി വീണ്ടും ഉറപ്പാക്കുക.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap grid gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">വിശദമായ യാത്രാമാർഗം</p><h2 class="section-title mt-2">മുന്നാർ പട്ടണത്തിൽ നിന്ന്</h2>
          <div class="route mt-7">
            <div class="route-step"><div class="route-no">1</div><div><h3 class="font-bold">Mattupetty / Top Station റോഡ് പിടിക്കുക</h3><p class="mt-1 text-sm leading-7 muted">മുന്നാർ സെൻട്രൽ ഭാഗത്തുനിന്ന് മാട്ടുപ്പെട്ടി ദിശയിലേക്ക് ടാക്സി, ഓട്ടോറിക്ഷ, സ്വകാര്യവാഹനം എന്നിവ എളുപ്പമാണ്.</p></div></div>
            <div class="route-step"><div class="route-no">2</div><div><h3 class="font-bold">Rose Nagar ഭാഗം ശ്രദ്ധിക്കുക</h3><p class="mt-1 text-sm leading-7 muted">ഗാർഡൻ റോഡിനോട് ചേർന്നതാണ്. തിരക്കുള്ള സമയങ്ങളിൽ ഇറങ്ങുന്നതിനും പാർക്ക് ചെയ്യുന്നതിനും അധിക സമയം കണക്കാക്കുക.</p></div></div>
            <div class="route-step"><div class="route-no">3</div><div><h3 class="font-bold">ഒറ്റ റൂട്ടിൽ കൂടുതൽ സ്ഥലങ്ങൾ</h3><p class="mt-1 text-sm leading-7 muted">Photo Point → Rose Garden → Mattupetty Dam → Echo Point / Kundala Lake → Top Station എന്ന ക്രമത്തിൽ ഒരു ദിവസത്തെ റൂട്ട് പ്ലാൻ ചെയ്യാം.</p></div></div>
          </div>
        </div>
        <div class="card p-3" id="map">
          <iframe class="map-frame" title="മുന്നാർ റോസ് ഗാർഡൻ Google മാപ്പ്" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Munnar%20Rose%20Garden%2C%20Munnar%20-%20Aluva%20Rd%2C%20Rose%20Nagar%2C%20Mattupetty%2C%20Munnar%2C%20Kerala%20685612%2C%20India&output=embed&hl=ml&gl=in"></iframe>
          <div class="p-4"><p class="text-sm font-bold">Munnar - Aluva Rd, Rose Nagar, Mattupetty, Munnar, Kerala 685612</p><a class="mt-2 inline-block text-sm text-[#b52e5f]" href="https://maps.app.goo.gl/caVTicvucY2XJR2x6" target="_blank" rel="noreferrer">Google Maps-ൽ തുറക്കുക ↗</a></div>
        </div>
      </div>
    </section>

    <section class="section bg-[#153f33] text-white">
