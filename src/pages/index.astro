---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';
import{sections,faq,sources,checked}from'../data/guide';
export const prerender=false;
const url='https://munnarrose.com/';const schema=[{'@context':'https://schema.org','@type':'TouristAttraction','@id':url+'#attraction',name:'Munnar Rose Garden / KFDC Floriculture Centre',alternateName:'മുന്നാർ റോസ് ഗാർഡൻ',url,hasMap:sources.maps},{'@context':'https://schema.org','@type':'WebSite','@id':url+'#website',name:'Munnar Rose independent guide',url,inLanguage:['ml-IN','en']},{'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,name:'Munnar Rose Garden — KFDC Identity, Hours & Fee Checks',inLanguage:['ml-IN','en'],about:{'@id':url+'#attraction'},isPartOf:{'@id':url+'#website'}},{'@context':'https://schema.org','@type':'FAQPage','@id':url+'#faq',mainEntity:faq.flatMap(f=>[f.ml,f.en].map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})))}];
const photos=[{src:'/images/pond-2017-900.jpg',alt:'2017 ലെ ചെറിയ ജലസസ്യക്കുളവും ചുറ്റുമുള്ള ഇലകളും / Historical Munnar Rose Gardens pond and foliage, IM3847',name:'Flora at Munnar Rose Gardens 12.jpg',author:'IM3847',date:'2017-08-31',source:'https://commons.wikimedia.org/wiki/File:Flora_at_Munnar_Rose_Gardens_12.jpg',height:675},{src:'/images/flower-2017-900.jpg',alt:'2017 ലെ പിങ്ക്-വെള്ള നിറത്തിലുള്ള പല ഇതളുകളുള്ള പൂവ്; റോസ് എന്ന് തിരിച്ചറിഞ്ഞിട്ടില്ല / Historical pink-white flower detail, species not identified as a rose',name:'A flower in the Rose garden in Munnar 01.jpg',author:'Soumendra Kumar Sahoo',date:'2017-04-29',source:'https://commons.wikimedia.org/wiki/File:A_flower_in_the_Rose_garden_in_Munnar_01.jpg',height:1200}];
---
<BaseLayout title="Munnar Rose Garden | KFDC സ്ഥലം, സമയം-ഫീസ് പരിശോധന" description="മാട്ടുപ്പെട്ടി റോഡിലെ KFDC Floriculture Centre: സമാനപേരുള്ള ഹോംസ്റ്റേയിൽനിന്നുള്ള വ്യത്യാസം, സമയം/ഫീസ് സ്ഥിരീകരണം, ഓഫീസ് ബന്ധപ്പെടൽ, ചരിത്രചിത്രങ്ങൾ, പ്രാദേശിക കാലാവസ്ഥ.">
<Fragment slot="head">{schema.map(x=><script type="application/ld+json" is:inline set:html={JSON.stringify(x)}/>)}</Fragment>
<section class="section hero"><div class="shell"><p class="kicker">മൂന്നാർ · കേരളം · ഇന്ത്യ / Munnar · Kerala · India</p><h1>മുന്നാർ റോസ് ഗാർഡൻ <span lang="en">Munnar Rose Garden · KFDC Floriculture Centre</span></h1><p class="lead">സ്ഥലം ആദ്യം തിരിച്ചറിയുക; പ്രവേശനസമയം, നിരക്ക്, ആവശ്യമായ സഹായം എന്നിവ നിലവിലെ ഉറവിടത്തിൽ സ്ഥിരീകരിച്ചശേഷം യാത്ര ആസൂത്രണം ചെയ്യുക.</p><p class="lead" lang="en">Identify the garden first, then confirm current access, charges and the assistance you need before travelling.</p><p><a class="button" href="#visit">സമയം-ഫീസ് / Access checks</a> <a class="button secondary" href="#location">സ്ഥലം / Location</a></p><p class="badge">★ 4.3 / 5 · 10,727 Google Maps · {checked}</p><p class="small">കൈകൊണ്ട് പരിശോധിച്ച തീയതി-സ്നാപ്ഷോട്ട്; സ്വയം പുതുക്കുന്നില്ല. / <span lang="en">Manual dated snapshot, not automatically updated.</span></p><figure class="hero-figure"><img src="/images/flowerbed-2017-1600.jpg" srcset="/images/flowerbed-2017-800.jpg 800w,/images/flowerbed-2017-1600.jpg 1600w" sizes="(max-width:1180px) 100vw,1100px" width="1600" height="1200" alt="2017 ലെ പിങ്ക് പൂക്കളും തൂക്കുചട്ടികളും ഉള്ള ചരിത്രചിത്രം; IM3847, Munnar Rose Gardens; ഇന്നത്തെ സ്ഥിതി അല്ല" fetchpriority="high"/><figcaption>IM3847 · 2017-08-31 · <a href={sources.license}>CC BY-SA 4.0</a> · <a href="#image-credits">ഉറവിടവും മാറ്റങ്ങളും / Source & changes</a></figcaption></figure></div></section>
<div class="shell">{sections.map(s=><section id={s.id} class="section"><h2>{s.ml}<span lang="en">{s.en}</span></h2>{s.paragraphs.map(p=><div class="language-pair"><p lang="ml">{p.ml}</p><p lang="en">{p.en}</p></div>)}{s.id==='contact'&&<p><a class="button" href="tel:+918289821408">KFDC office: +91 8289821408</a> <a href={sources.kfdc}>പ്രസിദ്ധീകരിച്ച ഉറവിടം / Source listing ↗</a></p>}{s.id==='location'&&<p><a class="button" href={sources.maps} target="_blank" rel="noopener noreferrer">Google Maps reference ↗</a> <a href={sources.division}>KFDC address reference ↗</a></p>}</section>)}</div>
<section id="gallery" class="section"><div class="shell"><h2>2017 ലെ ചിത്രങ്ങൾ <span lang="en">Historical 2017 photographs</span></h2><p>ഇവ ഇന്നത്തെ പൂക്കളോ സൗകര്യങ്ങളോ സ്ഥിരീകരിക്കുന്നില്ല. / <span lang="en">These photographs do not confirm present blooms or facilities.</span></p><div class="photo-grid">{photos.map(p=><figure><img src={p.src} width="900" height={p.height} alt={p.alt} loading="lazy"/><figcaption>{p.author} · {p.date} · <a href={p.source}>{p.name}</a> · <a href={sources.license}>CC BY-SA 4.0</a></figcaption></figure>)}</div></div></section>
<Weather/>
<section id="faq" class="section"><div class="shell"><h2>സാധാരണ ചോദ്യങ്ങൾ <span lang="en">Frequently asked questions</span></h2>{faq.map(f=><details class="card"><summary><span lang="ml">{f.ml[0]}</span><span lang="en">{f.en[0]}</span></summary><p lang="ml">{f.ml[1]}</p><p lang="en">{f.en[1]}</p></details>)}</div></section>
<section id="sources" class="section"><div class="shell"><h2>ഉറവിടങ്ങളും പരിശോധനയുടെ പരിധിയും <span lang="en">Sources and review limits</span></h2><p>പരിശോധന {checked}; രേഖ പരിശോധിച്ചതുകൊണ്ട് സ്ഥലത്തെ പ്രവേശനസൗകര്യമോ ദിവസത്തെ പ്രവർത്തനമോ നേരിട്ട് പരിശോധിച്ചതായി കരുതരുത്.</p><p lang="en">Reviewed {checked}. A document or Maps review is not an on-site accessibility or daily-operation inspection. Current admission, camera fees and daily hours remain unconfirmed.</p><ul><li><a href={sources.kfdc}>KFDC products / eco-shop locations</a> — Munnar Floriculture Centre / Rose Garden and published office contact.</li><li><a href={sources.division}>KFDC division addresses</a> — Rose Garden, Maatupetty Road.</li><li><a href={sources.tourism}>Kerala Tourism Responsible Tourism itinerary</a> — KFDC flower garden identity; visit slots are not opening hours.</li><li><a href="https://www.keralatourism.org/homestays/rose-gardens/443">Kerala Tourism accommodation listing</a> — separate Rose Gardens Homestay; property-owner supplied listing, not garden facilities.</li><li><a href={sources.maps}>Google Maps</a> — manual {checked} rating/address/closing/accessibility snapshot.</li></ul></div></section>
<section id="image-credits" class="section"><div class="shell"><h2>ചിത്രങ്ങളുടെ ഉറവിടവും ലൈസൻസും <span lang="en">Photo sources and licence</span></h2><ul><li>IM3847 · 2017-08-31 · <a href="https://commons.wikimedia.org/wiki/File:Flora_at_Munnar_Rose_Gardens_11.jpg">Flora at Munnar Rose Gardens 11.jpg</a> — flower-bed hero and social derivative.</li>{photos.map(p=><li>{p.author} · {p.date} · <a href={p.source}>{p.name}</a>.</li>)}</ul><p>എല്ലാ ചിത്രങ്ങളും <a href={sources.license}>CC BY-SA 4.0</a>. യഥാർത്ഥ ഫയലുകളുടെ ദിശ ശരിയാക്കി, വലിപ്പം കുറച്ച് JPEG ആയി കംപ്രസ് ചെയ്തു; സാമൂഹിക പങ്കിടൽ ചിത്രം മധ്യഭാഗം ക്രോപ്പ് ചെയ്തതാണ്. ദൃശ്യചട്ടം കൂടുതൽ ഭാഗം മറച്ചേക്കാം.</p><p lang="en">All photographs are CC BY-SA 4.0. Derivatives were auto-oriented, resized and JPEG-compressed; the social cover is centre-cropped. Layout framing may crop further. Share-alike attribution and change notices apply to these derivatives. Credits do not imply endorsement or grant additional subject rights. The photos show historical flower displays/pond/flower detail, not a full current garden survey; no species identification as a rose is made for the close-up.</p></div></section>
<section id="privacy" class="section"><div class="shell"><h2>സ്വകാര്യത <span lang="en">Privacy and services</span></h2><p>Google Analytics ഈ പേജിൽ സ്വയം ലോഡ് ചെയ്യുന്നു; കുക്കികളും പേജ്/ബ്രൗസർ/ഉപകരണ ഉപയോഗവിവരങ്ങളും Google ലേക്ക് പോകാം. ഇവിടെ സമ്മതം നൽകാനോ അത് നിർത്താനോ പ്രത്യേക നിയന്ത്രണം നൽകിയിട്ടില്ല.</p><p lang="en">Google Analytics retains its automatic loading. It may use cookies and send page, browser and device-usage information to Google; no site consent or disable control is offered. <a href="https://policies.google.com/privacy">Google privacy</a> · <a href="https://tools.google.com/dlpage/gaoptout">External browser opt-out tool</a>.</p><p>2026-10-30 ന് പരിശോധിച്ച ഒരു ഉൽപ്പാദന HTML പ്രതികരണത്തിൽ Cloudflare beacon സ്ക്രിപ്റ്റ് കണ്ടില്ല. ഇതു സേവനം ഇല്ലെന്നോ മറ്റൊരു പ്രതികരണത്തിലോ പിന്നീട് ചേർക്കില്ലെന്നോ തെളിയിക്കുന്നില്ല. Cloudflare ഹോസ്റ്റിംഗിന്റെ ബന്ധം/സുരക്ഷാ ഡാറ്റ കൈകാര്യം ബ്രൗസർ സ്ക്രിപ്റ്റിൽനിന്ന് വേറെയാകാം.</p><p lang="en">One production HTML response checked on 2026-10-30 did not show a Cloudflare beacon script. This does not establish absence in other responses or exclude later configuration changes. Cloudflare connection/security and edge-hosting processing can occur separately from a browser script.</p><p>ഹോസ്റ്റിംഗ് ക്രമീകരണം സ്വതന്ത്ര Cloudflare Web Analytics ചേർക്കാം: സന്ദർശനം, പേജ് കാഴ്ച, URL പാത, referrer, ബ്രൗസർ/ഉപകരണം, പ്രവർത്തനക്ഷമത എന്നിവയുടെ മെട്രിക്കുകൾ. ഇവിടെ അതിനുള്ള സ്വിച്ച് ഇല്ല. സ്ക്രിപ്റ്റ് കാണുന്നതുമാത്രം പ്രവർത്തനമോ ഡാറ്റ അയക്കലോ തെളിയിക്കില്ല.</p><p lang="en">Hosting may independently add Cloudflare Web Analytics measuring visits, page views, URL paths, referrers, browser/device information and performance; no site switch is provided for it. Script presence alone would not prove execution or transmission. <a href="https://developers.cloudflare.com/web-analytics/data-metrics/">Cloudflare documentation</a>.</p><p>കാലാവസ്ഥയ്ക്കായി ബ്രൗസർ ഈ സൈറ്റിലെ endpoint നെ ബന്ധപ്പെടുന്നു; സൈറ്റിന്റെ സർവർ സ്ഥിരമായ പ്രാദേശിക ബിന്ദുവിന് Open-Meteo യിൽനിന്ന് ഡാറ്റ എടുക്കുന്നു. ഉപകരണത്തിന്റെ സ്ഥലം ചോദിക്കുന്നില്ല. ചിത്രങ്ങൾ ഇവിടെനിന്ന് നൽകുന്നു; Maps എംബെഡ് ചെയ്തിട്ടില്ല. പുറംലിങ്കുകൾക്ക് അതത് സേവനത്തിന്റെ നയം ബാധകമാണ്.</p><p lang="en">Weather is requested from this site; its server contacts Open-Meteo for a fixed regional point, sharing server connection information rather than a direct visitor-browser request. Device location is not requested. Photos are local, Maps is linked rather than embedded, and external links use their providers’ policies. <a href="https://open-meteo.com/en/terms">Open-Meteo terms</a>.</p></div></section>
<section id="terms" class="section"><div class="shell"><h2>ഉപയോഗ നിബന്ധനകൾ <span lang="en">Use and limitations</span></h2><p>ഈ ഗൈഡ് ടിക്കറ്റ്, മുറി ബുക്കിംഗ്, അക്കൗണ്ട് സേവനം നൽകുന്നില്ല. സമയം, നിരക്ക്, വഴി, സൗകര്യം, കാലാവസ്ഥ എന്നിവ നിലവിലെ ബന്ധപ്പെട്ട ഉറവിടത്തിൽ സ്ഥിരീകരിക്കുക. ചിത്രങ്ങൾ ഇന്നത്തെ അവസ്ഥയുടെ തെളിവല്ല.</p><p lang="en">This independent guide does not provide ticket, accommodation-booking or account services. Confirm current opening, charges, routes and required facilities with the relevant source. A forecast is not an access or safety clearance, and historical photographs are not current-condition evidence.</p></div></section>
</BaseLayout>
