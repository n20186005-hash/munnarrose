---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';
import TopicLinks from '../components/TopicLinks.astro';
import{sections,faq,sources,checked,photos}from'../data/guide';
export const prerender=true;
const url='https://munnarrose.com/';const schema=[{'@context':'https://schema.org','@type':'TouristAttraction','@id':url+'#attraction',name:'Munnar Rose Garden / KFDC Floriculture Centre',alternateName:'മുന്നാർ റോസ് ഗാർഡൻ',url,hasMap:sources.maps},{'@context':'https://schema.org','@type':'WebSite','@id':url+'#website',name:'Munnar Rose Garden — independent guide',url,inLanguage:['ml-IN','en']},{'@context':'https://schema.org','@type':'WebPage','@id':url+'#webpage',url,name:'Munnar Rose Garden — KFDC Identity, Hours & Fee Checks',inLanguage:['ml-IN','en'],about:{'@id':url+'#attraction'},isPartOf:{'@id':url+'#website'}},{'@context':'https://schema.org','@type':'FAQPage','@id':url+'#faq',mainEntity:faq.flatMap(f=>[f.ml,f.en].map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})))}];
---
<BaseLayout title="Munnar Rose Garden – Timings, Entry Fee, Flowers & Visitor Guide" description="Plan your visit to Munnar Rose Garden in Kerala. See flower displays, learn how to confirm current timings and ticket information, find directions, and explore nearby Mattupetty attractions.">
<Fragment slot="head">{schema.map(x=><script type="application/ld+json" is:inline set:html={JSON.stringify(x)}/>)}</Fragment>
<section class="section hero"><div class="shell"><p class="kicker">മൂന്നാർ · കേരളം · ഇന്ത്യ / Munnar · Kerala · India</p><h1>മുന്നാർ റോസ് ഗാർഡൻ <span lang="en">Munnar Rose Garden · KFDC Floriculture Centre</span></h1><p class="lead">സ്ഥലം ആദ്യം തിരിച്ചറിയുക; പ്രവേശനസമയം, നിരക്ക്, ആവശ്യമായ സഹായം എന്നിവ നിലവിലെ ഉറവിടത്തിൽ സ്ഥിരീകരിച്ചശേഷം യാത്ര ആസൂത്രണം ചെയ്യുക.</p><p class="lead" lang="en">Identify the garden first, then confirm current access, charges and the assistance you need before travelling.</p><p><a class="button" href="#visit">സമയം-ഫീസ് / Access checks</a> <a class="button secondary" href="#location">സ്ഥലം / Location</a> <a class="button secondary" href={sources.maps} target="_blank" rel="noopener noreferrer">Directions / Google Maps ↗</a></p><p class="badge">★ 4.3 / 5 · 10,727 Google Maps · {checked}</p><p class="small">കൈകൊണ്ട് പരിശോധിച്ച തീയതി-സ്നാപ്ഷോട്ട്; സ്വയം പുതുക്കുന്നില്ല. / <span lang="en">Manual dated snapshot, not automatically updated.</span></p><figure class="hero-figure"><img src="/images/flowerbed-2017-1600.jpg" srcset="/images/flowerbed-2017-800.jpg 800w,/images/flowerbed-2017-1600.jpg 1600w" sizes="(max-width:1180px) 100vw,1100px" width="1600" height="1200" alt="2017 ലെ പിങ്ക് പൂക്കളും തൂക്കുചട്ടികളും ഉള്ള ചരിത്രചിത്രം; IM3847, Munnar Rose Gardens; ഇന്നത്തെ സ്ഥിതി അല്ല" fetchpriority="high"/><figcaption>IM3847 · 2017-08-31 · <a href={sources.license}>CC BY-SA 4.0</a> · <a href="/image-credits/">ഉറവിടവും മാറ്റങ്ങളും / Source & changes</a></figcaption></figure></div></section>
<div class="shell">{sections.map(s=><section id={s.id} class="section"><h2>{s.ml}<span lang="en">{s.en}</span></h2>{s.paragraphs.map(p=><div class="language-pair"><p lang="ml">{p.ml}</p><p lang="en">{p.en}</p></div>)}{s.id==='contact'&&<p><a class="button" href="tel:+918289821408">KFDC office: +91 8289821408</a> <a href={sources.kfdc}>പ്രസിദ്ധീകരിച്ച ഉറവിടം / Source listing ↗</a></p>}{s.id==='location'&&<p><a class="button" href={sources.maps} target="_blank" rel="noopener noreferrer">Google Maps reference ↗</a> <a href={sources.division}>KFDC address reference ↗</a></p>}</section>)}</div>
<TopicLinks/>
<section id="gallery" class="section"><div class="shell"><h2>2017 ലെ ചിത്രങ്ങൾ <span lang="en">Historical 2017 photographs</span></h2><p>ഇവ ഇന്നത്തെ പൂക്കളോ സൗകര്യങ്ങളോ സ്ഥിരീകരിക്കുന്നില്ല. / <span lang="en">These photographs do not confirm present blooms or facilities.</span></p><div class="photo-grid">{photos.map(p=><figure><img src={p.src} width="900" height={p.height} alt={p.alt} loading="lazy"/><figcaption>{p.author} · {p.date} · <a href={p.source}>{p.name}</a> · <a href={sources.license}>CC BY-SA 4.0</a></figcaption></figure>)}</div></div></section>
<Weather/>
<section id="faq" class="section"><div class="shell"><h2>സാധാരണ ചോദ്യങ്ങൾ <span lang="en">Frequently asked questions</span></h2>{faq.map(f=><details class="card"><summary><span lang="ml">{f.ml[0]}</span><span lang="en">{f.en[0]}</span></summary><p lang="ml">{f.ml[1]}</p><p lang="en">{f.en[1]}</p></details>)}</div></section>
</BaseLayout>
