---
import BaseLayout from '../layouts/BaseLayout.astro';

const imageSources = {
  hero: 'https://upload.wikimedia.org/wikipedia/commons/6/67/Flora_at_Munnar_Rose_Gardens_11.jpg',
  pond: 'https://upload.wikimedia.org/wikipedia/commons/0/06/Flora_at_Munnar_Rose_Gardens_12.jpg',
  foliage: 'https://upload.wikimedia.org/wikipedia/commons/1/1f/Flora_at_Munnar_Rose_Gardens_13.jpg',
  flower: 'https://upload.wikimedia.org/wikipedia/commons/5/54/A_flower_in_the_Rose_garden_in_Munnar_01.jpg'
};

const SITE_FALLBACK = 'https://munnarrose.com';
const siteUrl = (Astro.site?.toString() || SITE_FALLBACK).replace(/\/$/, '');

// 单景点 SEO 实体绑定配置
const entity = {
  domain: 'munnarrose.com',
  fullName: 'Munnar Rose Garden',
  shortName: 'Rose Garden',
  city: 'Munnar',
  state: 'Kerala',
  country: 'India',
  countryCode: 'IN',
  postalCode: '685612',
  streetAddress: 'Munnar - Aluva Rd, Rose Nagar, Mattupetty',
  latitude: 10.08583,
  longitude: 77.07583,
  mapsShareUrl: 'https://maps.app.goo.gl/caVTicvucY2XJR2x6',
  mapsEmbedSrc: 'https://www.google.com/maps?q=Munnar%20Rose%20Garden%2C%20Munnar%20-%20Aluva%20Rd%2C%20Rose%20Nagar%2C%20Mattupetty%2C%20Munnar%2C%20Kerala%20685612%2C%20India&output=embed&hl=ml&gl=in',
  nearby1: 'Mattupetty Dam',
  nearby2: 'Top Station',
  govtTourismUrl: 'https://www.keralatourism.org/'
};

// 谷歌地图用户评价：仅在页面正文展示，不写入 JSON-LD
const reviews = {
  ratingValue: '4.3',
  bestRating: '5',
  ratingNumber: 4.3,
  reviewCount: 10609,
  reviewCountLabel: '10,609',
  syncMonth: '2026 年 9 月',
  syncMonthEn: 'September 2026',
  sourceNote: '同步自 Google 地图用户评价，同步时间 2026 年 9 月；版权归原作者与 Google 地图所有'
};
const ratingPercent = Math.round((reviews.ratingNumber / Number(reviews.bestRating)) * 100);

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${siteUrl}/#attraction`,
  name: entity.fullName,
  alternateName: [
    entity.shortName,
    `${entity.shortName} ${entity.city}`,
    `Munnar ${entity.fullName}`,
    'KFDC Floriculture Centre'
  ],
  description: `Comprehensive visitor guide to ${entity.fullName} in ${entity.city}, ${entity.state}, ${entity.country}. Location map, opening details, nearby ${entity.nearby1}, and travel tips.`,
  url: siteUrl,
  image: [`${siteUrl}/images/rose-garden-hero.jpg`],
  telephone: '+91 94968 22059',
  isAccessibleForFree: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: entity.streetAddress,
    addressLocality: entity.city,
    addressRegion: entity.state,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode
  },
  geo: { '@type': 'GeoCoordinates', latitude: entity.latitude, longitude: entity.longitude },
  hasMap: entity.mapsShareUrl,
  sameAs: [entity.mapsShareUrl, entity.govtTourismUrl],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '08:00', closes: '18:00'
  }],
  priceRange: '₹'
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: entity.country, item: `${siteUrl}/#india` },
    { '@type': 'ListItem', position: 3, name: entity.state, item: `${siteUrl}/#kerala` },
    { '@type': 'ListItem', position: 4, name: entity.city, item: `${siteUrl}/#munnar` },
    { '@type': 'ListItem', position: 5, name: entity.fullName, item: `${siteUrl}/#attraction` }
  ]
};

const faq = [
  ['റോസ് ഗാർഡൻ സാധാരണ എപ്പോൾ തുറന്നിരിക്കും?', 'Google Maps-ൽ ഇപ്പോൾ ദിവസവും രാവിലെ 8 മുതൽ വൈകിട്ട് 6 വരെ എന്നാണ് കാണിക്കുന്നത്. സീസണൽ മാറ്റങ്ങൾ ഉണ്ടാകാം; യാത്രയ്ക്കു മുമ്പ് സമയക്രമം വീണ്ടും പരിശോധിക്കുക.'],
  ['പ്രവേശന ഫീസ് എത്രയാണ്?', 'സമീപകാല യാത്രക്കാരുടെ റിപ്പോർട്ടുകളിൽ ഒരാൾക്ക് ഏകദേശം ₹50 എന്ന് കാണുന്നു. നിരക്കുകൾ മാറാവുന്നതിനാൽ ടിക്കറ്റ് കൗണ്ടറിലെ നിലവിലെ നിരക്ക് സ്ഥിരീകരിക്കുക.'],
  ['എത്ര സമയം മാറ്റിവെക്കണം?', 'ഫോട്ടോഗ്രഫിയോടുകൂടിയ ശാന്തമായ സന്ദർശനത്തിന് 45–75 മിനിറ്റ് സാധാരണയായി മതിയാകും. പൂക്കളെയും നഴ്സറി വിഭാഗങ്ങളെയും വിശദമായി കാണണമെങ്കിൽ കൂടുതൽ സമയം അനുവദിക്കാം.'],
  ['കുട്ടികളോടൊപ്പം വരാൻ പറ്റുമോ?', 'അതെ. എന്നാൽ തോട്ടം കുന്നിൻ ചെരിവിലായി ടെറസുകളായി ക്രമീകരിച്ചിരിക്കുന്നതിനാൽ ചില ഭാഗങ്ങളിൽ പടികളും ചരിവുകളും ഉണ്ടാകാം.'],
  ['പാർക്കിംഗ് ലഭ്യമാണോ?', 'റോഡ്‌സൈഡ്/പ്രാദേശിക പാർക്കിംഗ് സാധാരണ ലഭ്യമാണെന്ന് പ്രാദേശിക ഗൈഡ് സ്രോതസ്സുകൾ പറയുന്നു. തിരക്കേറിയ സമയങ്ങളിൽ സ്ഥലം പരിമിതമായേക്കാം.'],
  ['മഴക്കാലത്ത് സന്ദർശിക്കാമോ?', 'സന്ദർശിക്കാം, പക്ഷേ പാതകൾ നനഞ്ഞിരിക്കാം. ഗ്രിപ്പ് ഉള്ള ചെരുപ്പും ലളിതമായ മഴക്കോടും ഉപകാരപ്പെടും.'],
  [`Where is ${entity.fullName} located?`, `${entity.fullName} is located on ${entity.streetAddress}, ${entity.city}, ${entity.state} ${entity.postalCode}, ${entity.country}, on the Munnar–Mattupetty road (plus code ${'33PG+C6 Munnar'}).`],
  [`What are the opening hours of ${entity.fullName}?`, `Google Maps currently lists ${entity.fullName} as open daily from 08:00 to 18:00. Hours can change with season and weather, so re-check before you travel.`],
  [`Is ${entity.shortName} free to visit?`, `No. ${entity.fullName} charges a small entry fee; recent traveller reports mention around ₹50 per person, with possible extra camera charges. Confirm the current rate at the ticket counter.`],
  [`How do I reach ${entity.fullName} from Munnar town?`, `Take the Mattupetty / Top Station road out of central Munnar by taxi, auto-rickshaw or private vehicle. The garden sits roadside at Rose Nagar, roughly 3 km from Munnar town towards ${entity.nearby1}.`],
  [`How much time should I plan at ${entity.fullName}?`, `Most visitors spend 45–75 minutes, which is enough for a slow walk and photography across the terraced beds. Plant lovers may want longer.`],
  [`What attractions are near ${entity.shortName}?`, `Nearby stops include ${entity.nearby1}, Kundala Lake, ${entity.nearby2}, Photo Point, Pothamedu Viewpoint and the Kannan Devan Tea Museum — all can be combined into one day's route.`]
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};
---
<BaseLayout
  title={`${entity.fullName} (${entity.city}) - Visitor Guide & Location | മുന്നാർ റോസ് ഗാർഡൻ`}
  description={`${entity.fullName} (${entity.city}, ${entity.state}, ${entity.country}): location map, 08:00–18:00 hours, entry fee, parking, nearby ${entity.nearby1} & ${entity.nearby2}, and practical travel tips.`}
  ogTitle={`${entity.fullName} - ${entity.city} Travel Guide`}
  ogDescription={`Official visitor guide to ${entity.fullName} in ${entity.city}, ${entity.state}, ${entity.country}.`}
  imageAlt={`${entity.fullName} in ${entity.city}`}
  siteName={entity.fullName}
>
  <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <header class="hero-photo" style={`background-image:url('${imageSources.hero}')`}>
    <nav class="wrap relative z-10 flex items-center justify-between py-5 text-white">
      <a href="#top" class="flex items-center gap-3 no-underline" aria-label="മുന്നാർ റോസ് ഗാർഡൻ ഹോം">
        <img src="/icons/logo.svg" alt="" width="48" height="48" />
        <div><strong class="block text-sm tracking-wide">MUNNAR</strong><span class="text-xs opacity-80">ROSE GARDEN</span></div>
      </a>
      <a href="#map" class="rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm no-underline backdrop-blur">മാപ്പ് കാണുക ↗</a>
    </nav>
    <div id="top" class="wrap relative z-10 flex min-h-[62vh] items-end pb-10 text-white">
      <div class="max-w-4xl">
        <nav class="mb-3 flex flex-wrap items-center gap-2 text-xs text-white/75" aria-label="Breadcrumb">
          <span class="font-semibold text-white">{entity.fullName}</span><span aria-hidden="true">→</span>
          <span>{entity.city}</span><span aria-hidden="true">→</span>
          <span>{entity.state}</span><span aria-hidden="true">→</span>
          <span>{entity.country}</span>
        </nav>
        <p class="eyebrow !text-pink-200">മുന്നാർ · കേരളം · 685612</p>
        <h1 class="title mt-3">{entity.fullName} ({entity.city})<span class="mt-3 block text-2xl font-semibold tracking-normal text-white/85 md:text-3xl">മലമഞ്ഞിനിടയിലെ ഒരു നിറഞ്ഞ പൂക്കാലം.</span></h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-white/85">റോസ് നഗറിൽ, മാട്ടുപ്പെട്ടിയിലേക്കുള്ള വഴിയരികിൽ പച്ചമലകളുടെയും ചായത്തോട്ടങ്ങളുടെയും പശ്ചാത്തലത്തിൽ ടെറസുകളായി വിരിയുന്ന മുന്നാർ റോസ് ഗാർഡൻ.</p>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-white/70">Welcome to <strong class="text-white">{entity.fullName}</strong>, widely recognized as the central <strong class="text-white">{entity.shortName}</strong> of {entity.city}. Located in the heart of {entity.city}, {entity.state}, {entity.country}, this destination serves as a primary hub for travelers visiting the region.</p>
        <div class="facts mt-8">
          <div class="fact"><span class="text-xs opacity-70">Google റേറ്റിംഗ് / 谷歌评分</span><strong class="mt-1 block text-lg">{reviews.ratingValue} / {reviews.bestRating}</strong><span class="mt-0.5 block text-xs opacity-85">{reviews.reviewCountLabel} 条谷歌评价</span></div>
          <div class="fact"><span class="text-xs opacity-70">സമയം</span><strong class="mt-1 block text-lg">08:00–18:00</strong></div>
          <div class="fact"><span class="text-xs opacity-70">ശുപാർശ സമയം</span><strong class="mt-1 block text-lg">45–75 മിനിറ്റ്</strong></div>
          <div class="fact"><span class="text-xs opacity-70">സ്ഥാനം</span><strong class="mt-1 block text-lg">Rose Nagar</strong></div>
        </div>
        <p class="mt-4 max-w-2xl text-xs leading-6 text-white/70">评分与评价数同步自谷歌地图（Google Maps）用户评价 · {reviews.syncMonth} · <a class="underline decoration-white/40 underline-offset-2 hover:text-white" href={entity.mapsShareUrl} target="_blank" rel="noopener noreferrer">点击查看谷歌地图全部评价↗</a></p>
      </div>
    </div>
    <div class="petals"><i class="petal" style="left:11%;top:19%;--r:18deg"></i><i class="petal" style="left:74%;top:22%;--r:73deg"></i><i class="petal" style="left:88%;top:55%;--r:18deg"></i><i class="petal" style="left:62%;top:72%;--r:120deg"></i></div>
  </header>

  <main>
    <section class="section">
      <div class="wrap grid gap-10 lg:grid-cols-[.9fr_1.4fr] lg:items-center">
        <div class="flowers">
          <p class="eyebrow">പുഷ്പോദ്യാനം</p>
          <h2 class="section-title mt-2">About {entity.fullName} · റോസുകൾ മാത്രം അല്ല.</h2>
          <p class="mt-5 leading-8 muted">റോസുകൾക്കൊപ്പം വിവിധ അലങ്കാരച്ചെടികൾ, ജലസസ്യങ്ങൾ, പച്ചച്ചെടികൾ, ഔഷധ/മസാല സസ്യങ്ങൾ എന്നിവയും കാണാം. കുന്നിൻ ചെരിവിനനുസരിച്ചുള്ള പടിനില ക്രമീകരണം തോട്ടത്തിന് മുന്നാറിന്റെ സ്വാഭാവിക ഭൂപ്രകൃതിയോട് ചേർന്നൊരു വ്യക്തിത്വം നൽകുന്നു.</p>
          <div class="mt-6 flex flex-wrap gap-2"><span class="chip">🌹 നിറവൈവിധ്യം</span><span class="chip">📷 ഫോട്ടോഗ്രഫി</span><span class="chip">🌿 സസ്യപരിചയം</span><span class="chip">⛰️ മലക്കാഴ്ച</span></div>
        </div>
        <div class="photo-grid" aria-label="മുന്നാർ റോസ് ഗാർഡന്റെ യഥാർത്ഥ ചിത്രങ്ങൾ">
          <img src={imageSources.hero} alt={`${entity.fullName} - Main view in ${entity.city}, ${entity.country}`} loading="eager" />
          <img src={imageSources.pond} alt={`${entity.fullName} - Water plant pond in ${entity.city}, ${entity.country}`} loading="lazy" />
          <img src={imageSources.foliage} alt={`${entity.fullName} - Terraced foliage beds in ${entity.city}, ${entity.country}`} loading="lazy" />
          <img src={imageSources.flower} alt={`${entity.fullName} - Close-up of a rose in bloom, ${entity.city}`} loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section bg-[#f6f2ea]" id="history">
      <div class="wrap grid gap-10 lg:grid-cols-[1.05fr_1.35fr]">
        <div>
          <p class="eyebrow">ചരിത്രവും പ്രാധാന്യവും</p>
          <h2 class="section-title mt-2">History &amp; Significance of {entity.fullName}</h2>
          <p class="mt-5 leading-8 muted">Local tourism listings describe {entity.fullName} as a floriculture centre developed along the {entity.city}–Mattupetty corridor, roadside at Rose Nagar on the Munnar - Aluva Rd. Its beds are cut into the hillside, so the garden reads as a set of green steps above the road rather than a flat municipal park.</p>
          <p class="mt-4 leading-8 muted">ചായത്തോട്ടങ്ങൾക്കും മാട്ടുപ്പെട്ടി റൂട്ടിനും ഇടയിലുള്ള ചെറിയ ഇടവേളയായാണ് കൂടുതൽ യാത്രക്കാരും ഈ പൂന്തോട്ടം ഉപയോഗിക്കുന്നത്; കുന്നിൻ ചെരിവിനനുസരിച്ചുള്ള പടിനില ക്രമീകരണം മുന്നാറിന്റെ ഭൂപ്രകൃതിയോട് ചേർന്നുനിൽക്കുന്നു.</p>
          <p class="mt-4 text-sm leading-7 muted">Geographic hierarchy: <strong>{entity.fullName}</strong> → {entity.city} → {entity.state} → {entity.country}. See the current listing on <a class="text-[#b52e5f] underline underline-offset-2" href={entity.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a>.</p>
        </div>
        <div class="card p-6 md:p-8">
          <h3 class="text-lg font-bold">Why {entity.shortName} matters on a {entity.city} itinerary</h3>
          <ul class="mt-4 space-y-3 text-sm leading-7 muted">
            <li><strong class="text-[color:var(--ink)]">Botanical:</strong> rose beds plus ornamental flowers, aquatic plants, foliage and spice/medicinal species, with nursery sections that interest plant lovers.</li>
            <li><strong class="text-[color:var(--ink)]">Landscape:</strong> the terraced hillside layout keeps the natural slope visible, which is why the garden photographs differently from flat city parks.</li>
            <li><strong class="text-[color:var(--ink)]">Route:</strong> a short, low-effort stop that fits between the tea estates, Photo Point and {entity.nearby1} on one day's loop.</li>
            <li><strong class="text-[color:var(--ink)]">Practical:</strong> shade, seating, washrooms and small refreshment options nearby make it an easy break on the Mattupetty road.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section bg-[#eef5ec]">
      <div class="wrap">
        <p class="eyebrow">പ്ലാൻ ചെയ്യാം</p><h2 class="section-title mt-2">സന്ദർശനത്തിന് വേണ്ട പ്രധാന വിവരങ്ങൾ</h2>
        <div class="info-grid mt-8">
          <article class="card info-card"><div class="icon">🎟️</div><h3 class="mt-4 font-bold">ടിക്കറ്റ് / ഫീസ്</h3><p class="mt-2 text-sm leading-7 muted">യാത്രക്കാരുടെ സമീപകാല റിപ്പോർട്ടുകളിൽ ഏകദേശം ₹50/വ്യക്തി. നിരക്കുകൾ മാറാം; കൗണ്ടറിൽ സ്ഥിരീകരിക്കുക.</p></article>
          <article class="card info-card"><div class="icon">🕗</div><h3 class="mt-4 font-bold">മികച്ച സമയം</h3><p class="mt-2 text-sm leading-7 muted">രാവിലെ 8–10 അല്ലെങ്കിൽ വൈകുന്നേരത്തെ മൃദുവായ വെളിച്ചം. മഴയ്ക്ക് ശേഷമുള്ള പച്ചപ്പും മനോഹരം, പക്ഷേ പാതകൾ വഴുക്കാം.</p></article>
