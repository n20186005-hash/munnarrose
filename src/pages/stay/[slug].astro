---
import TopicPage from '../../components/TopicPage.astro';
import { topicsForGroup, type Topic } from '../../data/topics';

export const prerender = true;

export function getStaticPaths() {
  return topicsForGroup('stay').map((t) => ({ params: { slug: t.slug.split('/').pop() }, props: { topic: t } }));
}

const { topic } = Astro.props as { topic: Topic };
---
<TopicPage topic={topic} />
